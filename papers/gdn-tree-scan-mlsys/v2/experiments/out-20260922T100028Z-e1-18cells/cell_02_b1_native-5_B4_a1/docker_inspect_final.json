        "Path": "bash",
        "Args": [
            "-lc",
            "set -euo pipefail\n# NATIVE path: NO forked-fa2 .so copy, NO fa2-tree-bias patch. Stock vLLM loads the model's native MTP head from the\n# qwen3_5_mtp method. E1 (opt-in): the FR13 patcher (all features OFF by env) only to provide the forward-timer anchors of\n# the E1 event recorder, then the recorder shim.\n# no in-container shim (FR13_NATIVE_NVFP4_LMHEAD_SHIM unset)\nif [[ -n \"${E1_SHIM_PATH:-}\" ]]; then\n  python3 /workspace/scripts/fr10_phase4_patch_vllm_tree_gdn.py\n  python3 \"${E1_SHIM_PATH}\" --report /logs/e1_event_recorder_shim.json\nfi\nexec vllm serve /models/qwen3.6-27b-fp8 --served-model-name qwen3.6-27b   --host 0.0.0.0 --port 9950 --max-num-seqs '4'   --gpu-memory-utilization '0.6' --max-model-len '16384' --seed '20260921'   --attention-backend 'FLASH_ATTN' --gdn-prefill-backend triton   --chat-template /workspace/docker/chat_templates/qwen3-openai-codex.jinja   --enable-auto-tool-choice --tool-call-parser qwen3_xml --reasoning-parser qwen3   --speculative-config \"$SPEC_CONFIG\" --no-enable-prefix-caching   --enforce-eager   --no-async-scheduling"
