            else:\n                required_columns = self._required_columns\n\n            plural = 's' if len(required_columns) > 1 else ''\n\n            if not self._required_columns_relax and len(self.colnames) == 0:\n\n                raise ValueError(\n                    f\"{self.__class__.__name__} object is invalid - expected '{required_columns[0]", "content": "", "tool_calls": "", "spec_delta": {"vllm:spec_decode_num_drafts{engine=\"0\",model_name=\"qwen3.8-27b-nvfp4-radixark\"}": 107.0, "vllm:spec_decode_num_accepted_tokens_per_pos{engine=\"0\",model_name=\"qwen3.8-27b-nvfp4-radixark\",position=\"4\"}": 26.0, "vllm:spec_decode_num_draft_tokens{engine=\"0\",model_name=\"qwen3.8-27b-nvfp4-radixark\"}": 3317.0, "vllm:spec_decode_num_accepted_tokens_per_pos{engine=\"0\",model_name=\"qwen3.8-27b-nvfp4-radixark\",position=\"7\"}": 14.0, "vllm:spec_decode_num_accepted_tokens{engine=\"0\",model_name=\"qwen3.8-27b-nvfp4-radixark\"}": 408.0, "vllm:spec_decode_num_accepted_tokens_per_pos{engine=\"0\",model_name=\"qwen3.8-27b-nvfp4-radixark\",position=\"2\"}": 72.0, "vllm:spec_decode_num_accepted_tokens_per_pos{engine=\"0\",model_name=\"qwen3.8-27b-nvfp4-radixark\",position=\"9\"}": 12.0, "vllm:spec_decode_num_accepted_tokens_per_pos{engine=\"0\",model_name=\"qwen3.8-27b-nvfp4-radixark\",position=\"8\"}": 13.0, "vllm:spec_decode_num_accepted_tokens_per_pos{engine=\"0\",model_name=\"qwen3.8-27b-nvfp4-radixark\",position=\"0\"}": 103.0, "vllm:spec_decode_num_accepted_tokens_per_pos{engine=\"0\",model_name=\"qwen3.8-27b-nvfp4-radixark\",position=\"10\"}": 12.0, "vllm:spec_decode_num_accepted_tokens_per_pos{engine=\"0\",model_name=\"qwen3.8-27b-nvfp4-radixark\",position=\"3\"}": 32.0, "vllm:spec_decode_num_accepted_tokens_per_pos{engine=\"0\",model_name=\"qwen3.8-27b-nvfp4-radixark\",position=\"5\"}": 19.0, "vllm:spec_decode_num_accepted_tokens_per_pos{engine=\"0\",model_name=\"qwen3.8-27b-nvfp4-radixark\",position=\"1\"}": 90.0, "vllm:spec_decode_num_accepted_tokens_pe