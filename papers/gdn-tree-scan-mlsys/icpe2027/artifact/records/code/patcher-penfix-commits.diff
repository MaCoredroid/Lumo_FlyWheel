+        "        if any_penalties_or_bad_words:\n"
+        "            output_token_ids = self._combine_outputs_with_spec_tokens(\n"
+        "                output_token_ids,\n"
+        "                sampling_metadata.spec_token_ids,\n"
+        "            )\n"
+    )
+    if text.count(call_anchor) != 1:
