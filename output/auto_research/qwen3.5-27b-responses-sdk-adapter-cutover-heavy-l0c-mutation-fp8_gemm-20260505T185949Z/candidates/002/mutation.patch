 namespace vllm::c3x {
 
+struct CutlassWorkspaceCacheEntry {
+  int device_id;
+  cudaStream_t stream;
+  torch::Tensor buffer;
+};
+
 static inline cute::Shape<int, int, int, int> get_problem_shape(
     torch::Tensor const& a, torch::Tensor const& b) {
   int32_t m = a.size(0), n = b.size(1), k = a.size(1);
   return {m, n, k, 1};
 }
 
+static inline void* get_cutlass_workspace_ptr(torch::Device device,
+                                              cudaStream_t stream,
+                                              size_t workspace_size) {
+  if (workspace_size == 0) {
+    return nullptr;
+  }
+
+  int device_id = static_cast<int>(device.index());
+  if (device_id < 0) {
+    device_id = 0;
+  }
+
+  thread_local std::vector<CutlassWorkspaceCacheEntry> workspace_cache;
+  for (auto& entry : workspace_cache) {
+    if (entry.device_id == device_id && entry.stream == stream) {
+      if (!entry.buffer.defined() ||
+          static_cast<size_t>(entry.buffer.numel()) < workspace_size) {
+        auto const workspace_options =
+            torch::TensorOptions().dtype(torch::kUInt8).device(device);
+        entry.buffer = torch::empty(workspace_size, workspace_options);
+      }
+      return entry.buffer.data_ptr();
+    }
+  }
+
+  auto const workspace_options =
+      torch::TensorOptions().dtype(torch::kUInt8).device(device);
+  workspace_cache.push_back(
+      {device_id, stream, torch::empty(workspace_size, workspace_options)});
+  return workspace_cache.back().buffer.data_ptr();
+}
