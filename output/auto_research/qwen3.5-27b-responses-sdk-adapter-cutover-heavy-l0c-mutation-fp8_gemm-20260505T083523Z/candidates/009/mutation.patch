+    def can_apply_pre_quantized_cutlass_block_fp8(
+        self,
+        input_: torch.Tensor,
+        output_dtype: torch.dtype,
+    ) -> bool:
+        if not self.input_is_parallel:
+            return False
+
+        can_apply_pre_quantized = getattr(
+            self.quant_method, "can_apply_pre_quantized_cutlass_block_fp8", None
+        )
+        if can_apply_pre_quantized is None:
+            return False
+
+        return can_apply_pre_quantized(self, input_, output_dtype)
+
+    def apply_pre_quantized_cutlass_block_fp8(
+        self,
+        input_q: torch.Tensor,
+        input_scale: torch.Tensor,
+        output_dtype: torch.dtype,
+    ) -> torch.Tensor | tuple[torch.Tensor, Parameter | None] | None:
+        if not self.input_is_parallel:
+            return None
+
+        apply_pre_quantized = getattr(
+            self.quant_method, "apply_pre_quantized_cutlass_block_fp8", None
+        )
+        if apply_pre_quantized is None:
+            return None
+
+        bias_ = None if (self.tp_rank > 0 or self.skip_bias_add) else self.bias
+        output_parallel = apply_pre_quantized(
+            self, input_q, input_scale, output_dtype, bias_
+        )
+        if output_parallel is None:
+            return None
+
+        if self.reduce_results and self.tp_size > 1:
+            output = tensor_model_parallel_all_reduce(output_parallel)
+        else:
+            output = output_parallel
+
+        if not self.return_bias:
+            return output
+        output_bias = self.bias if self.skip_bias_add else None
+        return output, output_bias
+
     def extra_repr(self) -> str:
