+    def _should_use_triton_gb10_decode_path(
+        self,
+        input_2d: torch.Tensor,
+        weight: torch.Tensor,
+        output_dtype: torch.dtype,
+    ) -> bool:
+        if not self.use_triton_gb10_decode_path:
+            return False
+
+        M, K = input_2d.shape
+        N = weight.shape[0]
+        return (
+            M <= 16
+            and output_dtype == torch.bfloat16
+            and input_2d.dtype == torch.bfloat16
+            and weight.dtype == torch.float8_e4m3fn
+            and self.act_quant_group_shape == GroupShape(1, 128)
+            and self.weight_group_shape == GroupShape(128, 128)
+            and N % 128 == 0
+            and K % 128 == 0
+        )
