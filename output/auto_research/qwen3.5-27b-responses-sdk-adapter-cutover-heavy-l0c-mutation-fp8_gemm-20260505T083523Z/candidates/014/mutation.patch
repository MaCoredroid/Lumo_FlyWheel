+static inline cutlass::KernelHardwareInfo get_cached_kernel_hardware_info(
+    torch::Device device) {
+  int device_id = static_cast<int>(device.index());
+  if (device_id < 0) {
+    device_id = 0;
+  }
+
+  thread_local int cached_device_id = -1;
+  thread_local int cached_sm_count = 0;
+
+  if (cached_device_id != device_id || cached_sm_count <= 0) {
+    cached_device_id = device_id;
+    cached_sm_count =
+        cutlass::KernelHardwareInfo::query_device_multiprocessor_count(
+            device_id);
+  }
+
+  return cutlass::KernelHardwareInfo{device_id, cached_sm_count};
+}
+
+static inline void* get_cached_cutlass_workspace(torch::Device device,
+                                                 cudaStream_t stream,
+                                                 size_t workspace_size) {
+  if (workspace_size == 0) {
+    return nullptr;
+  }
+
+  int device_id = static_cast<int>(device.index());
+  if (device_id < 0) {
+    device_id = 0;
+  }
+
+  auto stream_bits = static_cast<uint64_t>(reinterpret_cast<uintptr_t>(stream));
+  uint64_t cache_key = (static_cast<uint64_t>(device_id) << 48) ^ stream_bits;
+
+  thread_local std::unordered_map<uint64_t, torch::Tensor> workspace_cache;
+  torch::Tensor& workspace = workspace_cache[cache_key];
+  if (!workspace.defined() ||
+      workspace.numel() < static_cast<int64_t>(workspace_size)) {
+    auto const workspace_options =
+        torch::TensorOptions().dtype(torch::kUInt8).device(device);
+    workspace = torch::empty(workspace_size, workspace_options);
+  }
+
+  return workspace.data_ptr();
+}
