@@ -16,6 +16,10 @@
     return cutlass_scaled_mm_sm120_fp8_epilogue<c3x::ScaledEpilogueBias>(
         out, a, b, a_scales, b_scales, *bias);
   } else {
+    if (a_scales.numel() == a.size(0) && b_scales.numel() == b.size(1)) {
+      return cutlass_scaled_mm_sm120_fp8_epilogue<
+          c3x::ScaledEpilogueRowColumn>(out, a, b, a_scales, b_scales);
+    }
     return cutlass_scaled_mm_sm120_fp8_epilogue<c3x::ScaledEpilogue>(
         out, a, b, a_scales, b_scales);
   }
