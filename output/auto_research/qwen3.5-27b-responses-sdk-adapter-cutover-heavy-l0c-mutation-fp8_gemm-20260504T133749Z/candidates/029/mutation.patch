+static inline cutlass::KernelHardwareInfo get_cached_kernel_hardware_info(
+    torch::Device device) {
+  int device_id = static_cast<int>(device.index());
+  thread_local int cached_device_id = -1;
+  thread_local int cached_sm_count = 0;
+
+  if (cached_device_id != device_id || cached_sm_count <= 0) {
+    cached_device_id = device_id;
+    cached_sm_count =
+        cutlass::KernelHardwareInfo::query_device_multiprocessor_count(
+            device_id);
+  }
+
+  return cutlass::KernelHardwareInfo{device_id, cached_sm_count};
+}
