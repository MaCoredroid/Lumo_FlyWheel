+            self.vllm_config,
+            num_tokens=input_batch_size,
+            num_tokens_across_dp=batch_size_across_dp,
+            cudagraph_runtime_mode=cudagraph_runtime_mode,
+            slot_mapping=self._get_slot_mapping(input_batch_size),
+        ):
