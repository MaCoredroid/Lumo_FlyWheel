+def _lumo_fb_ir_debug(event):
+    if _lumo_fb_ir_os.environ.get("LUMO_FB_DEBUG") != "1":
+        return
+    try:
+        global _LUMO_FB_IR_DBG_FH
+        try:
+            _LUMO_FB_IR_DBG_FH
+        except NameError:
+            _LUMO_FB_IR_DBG_FH = open("/logs/fb_internal_debug.jsonl", "a", buffering=1)
