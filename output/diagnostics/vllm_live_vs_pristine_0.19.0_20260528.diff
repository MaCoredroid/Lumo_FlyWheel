+            "kind": "qwen35_mamba_deltanet_recurrent_state_diagnostic",
+            "request_id": req_id,
+            "reason": reason,
+            **details,
+        }
+        self._write_json(f"state_diag_req_{_safe_name(req_id)}_{reason}.json", payload)
