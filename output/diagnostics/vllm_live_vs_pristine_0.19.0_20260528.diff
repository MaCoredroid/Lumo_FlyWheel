+    try:
+        import json as _fbj, time as _fbt
+        global _LUMO_FB_STATE_DBG_FH
+        try:
+            _LUMO_FB_STATE_DBG_FH
+        except NameError:
+            _LUMO_FB_STATE_DBG_FH = open("/logs/fb_state_debug.jsonl", "a", buffering=1)
+        marker = "::lumo_fb::"
