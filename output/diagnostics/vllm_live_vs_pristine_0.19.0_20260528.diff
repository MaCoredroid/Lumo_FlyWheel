+        if self.supports_mm_inputs:
+            self.inputs_embeds[:batch_size] = self.model.embed_input_ids(input_ids)
+            input_ids_arg = None
+            inputs_embeds = self.inputs_embeds[:input_batch_size]
+        else:
+            input_ids_arg = self.input_ids[:input_batch_size]
+            inputs_embeds = None
