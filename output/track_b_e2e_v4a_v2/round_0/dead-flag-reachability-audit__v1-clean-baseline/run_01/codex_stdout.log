al control.\\\"\n    },\n    {\n      \\\"flag\\\": \\\"ENABLE_PREVIEW_V2\\\",\n      \\\"action\\\": \\\"deprecate\\\",\n      \\\"blockers\\\": [\\\"legacy deploy manifests may still reference this flag\\\"],\n      \\\"rationale\\\": \\\"Alias flag with no standalone value. Deprecate after confirming no active deployments depend on it.\\\"\n    },\n    {\n      \\\"flag\\\": \\\"PREVIEW_FORCE_LEGACY\\\",\n      \\\"action\\\": \\\"docs_cleanup\\\",\n      \\\"blockers\\\": [\\\"operators\\\",\n      \\\"blockers\\\": [\\\"need to update operator runbooks and remove references to this flag\\\",\n      \\\"rationale\\\": \\\"Flag is dead for runtime branching but may be referenced in operator docs and runbooks. Clean up documentation and telemetry labels.\\\"\n    }\n  ],\n  \\\"assumption_ledger\\\": [\n    {\n      \\\"status\\\": \\\"observed\\\",\n      \\\"topic\\\": \\\"parser vs runtime distinction\\\",\n      \\\"note\\\": \\\"Parser hits in config.py do not guarantee runtime branching\\\"\n    },\n    {\n      \\\"status\\\": \\\"observed\\\",\n      \\\"topic\\\": \\\"alias semantics\\\",\n      \\\"note\\\": \\\"ENABLE_PREVIEW_V2 aliases to ENABLE_SHADOW_PREVIEW for legacy support\\\"\n    },\n    {\n      \\\"status\\\": \\\"missing\\\",\n      \\\"topic\\\": \\\"active deploy manifest inventory\\\",\n      \\\"note\\\": \\\"Cannot verify if any live deployments still use ENABLE_PREVIEW_V2\\\"\n    }\n  ]\n}\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
