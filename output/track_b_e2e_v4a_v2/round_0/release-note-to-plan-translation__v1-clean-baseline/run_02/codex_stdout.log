{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/usr/bin/bash -lc 'cat /workspace/tests/test_plan_brief.py'","aggregated_output":"from __future__ import annotations\n\nimport json\nimport pathlib\n\nimport pytest\n\nWS = pathlib.Path(\"/workspace\") if pathlib.Path(\"/workspace\").exists() else pathlib.Path(__file__).resolve().parents[1]\nBRIEF_JSON = WS / \"brief\" / \"manager_brief.json\"\nBRIEF_MD = WS / \"brief\" / \"manager_brief.md\"\nVARIANT_MARKER = WS / \".scenario_variant\"\n\n\ndef _load() -> dict:\n    if not BRIEF_JSON.exists():\n        pytest.fail(f\"brief json missing at {BRIEF_JSON}\")\n    try:\n        return json.loads(BRIEF_JSON.read_text())\n    except json.JSONDecodeError as exc:\n        pytest.fail(f\"brief json invalid: {exc}\")\n\n\ndef test_brief_files_exist():\n    assert BRIEF_JSON.exists()\n    assert BRIEF_MD.exists()\n    assert BRIEF_MD.read_text().strip()\n\n\ndef test_variant_matches_marker():\n    data = _load()\n    assert data[\"variant_id\"] == VARIANT_MARKER.read_text().strip()\n\n\ndef test_first_milestone_matches_rank_1():\n    data = _load()\n    ordered = data[\"ordered_steps\"]\n    assert ordered[0][\"step_id\"] == data[\"first_milestone_id\"]\n\n\ndef test_ordered_steps_are_contiguous():\n    data = _load()\n    ordered = data[\"ordered_steps\"]\n    assert len(ordered) >= 3\n    ranks = sorted(step[\"rank\"] for step in ordered)\n    assert ranks == list(range(1, len(ordered) + 1))\n    assert len({step[\"step_id\"] for step in ordered}) == len(ordered)\n\n\ndef test_dependency_notes_reference_known_steps():\n    data = _load()\n    step_ids = {step[\"step_id\"] for step in data[\"ordered_steps\"]}\n    assert data[\"dependency_notes\"]\n    for note in data[\"dependency_notes\"]:\n        assert note[\"before\"] in step_ids\n        assert note[\"after\"] in step_ids\n        assert note[\"reason\"].strip()\n\n\ndef test_primary_risk_and_assumptions_present():\n    data = _load()\n    primary_risk = data[\"primary_risk\"]\n    assert primary_risk[\"statement\"].strip()\n    assert len(primary_risk[\"evidence\"]) >= 1\n    assert len(primary_risk[\"mitigations\"]) >= 2\n    assert any(row[\"status\"] == \"missing\" for row in data[\"assumption_ledger\"])\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_19","type":"agent_message","text":"\n\nNow I have all the information I need. Let me analyze and create the brief:\n\n**Analysis:**\n1. **Release notes (RN-101 to RN-104) outline the plan:\n- **RN-101**: Audit translator schema drift before removing legacy parser shim\n- **RN-102**: Backfill dependency-graph fixtures for plan contract\n- **RN-103**: Enable dashboard summary behind kill switch (after schema stable)\n- **RN-104**: Update runbook after summary path proven in canary\n\n**Dependencies from repo_inventory:**\n- Dashboard summary consumes step-id schema from translator\n- Dashboard must not ship until dependency-graph fixtures reflect new schema\n- Runbook stabilizes after rollout/rollback shape known\n- Legacy parser shim masks schema drift\n- Dashboard is user-visible and renders whatever order translator emits\n\n**Test evidence:**\n- `tests/plan_contract.py` fails when new step ids introduced without fixture updates\n- Canary-only coverage for dashboard, not for bad dependency ordering\n\n**Ordering logic:**\n1. **RN-101 first** - Audit schema drift (de before any changes (de-risks everything)\n2. **RN-102 second** - Backfill fixtures (required before dashboard can work)\n3. **RN-103 third** - Enable dashboard (depends on schema + fixtures)\n4. **RN-104 fourth** - Update runbook (depends on proven rollout)\n\n"}}
