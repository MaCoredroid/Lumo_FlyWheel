tor notes.\\\"\n  },\n  \\\"cleanup_plan\\\": [\n    {\n      \\\"flag\\\": \\\"ENABLE_SHADOW_PREVIEW\\\",\n      \\\"action\\\": \\\"keep\\\",\n      \\\"rationale\\\": \\\"This is the active live flag controlling the preview router branch. Removing it would break the shadow preview path entirely.\\\",\n      \\\"blockers\\\": []\n    },\n    {\n      \\\"flag\\\": \\\"ENABLE_PREVIEW_V2\\\",\n      \\\"action\\\": \\\"deprecate\\\",\n      \\\"rationale\\\": \\\"Live alias retained for legacy deploy manifests only. Should be deprecated with a migration path to ENABLE_SHADOW_PREVIEW before removal.\\\",\n      \\\"blockers\\\": [\n        \\\"Legacy deploy manifests still reference ENABLE_PREVIEW_V2\\\"\n      ]\n    },\n    {\n      \\\"flag\\\": \\\"PREVIEW_FORCE_LEGACY\\\",\n      \\\"action\\\": \\\"docs_cleanup\\\",\n      \\\"rationale\\\": \\\"Parser presence with no runtime branching. Only used for reporting labels. Keep telemetry while cleaning up docs to mark as dead.\\\",\n      \\\"blockers\\\": [\n        \\\"Operator notes still reference PREVIEW_FORCE_LEGACY for historical context\\\"\n      ]\n    }\n  ],\n  \\\"assumption_ledger\\\": [\n    {\n      \\\"status\\\": \\\"observed\\\",\n      \\\"topic\\\": \\\"Python runtime\\\",\n      \\\"note\\\": \\\"Dockerfile confirms python:3.11-slim base image for execution\\\"\n    },\n    {\n      \\\"status\\\": \\\"observed\\\",\n      \\\"topic\\\": \\\"Flag count\\\",\n      \\\"note\\\": \\\"Exactly three flags defined in defaults.toml and config.py parser\\\"\n    },\n    {\n      \\\"status\\\": \\\"to_verify\\\",\n      \\\"topic\\\": \\\"Deploy manifests\\\",\n      \\\"note\\\": \\\"Legacy deploy manifests referencing ENABLE_PREVIEW_V2 are outside this workspace\\\"\n    },\n    {\n      \\\"status\\\": \\\"missing\\\",\n      \\\"topic\\\": \\\"Deployment state\\\",\n      \\\"note\\\": \\\"No release_context or incident_context directories present in this workspace copy\\\"\n    }\n  ]\n}\nJSONEO