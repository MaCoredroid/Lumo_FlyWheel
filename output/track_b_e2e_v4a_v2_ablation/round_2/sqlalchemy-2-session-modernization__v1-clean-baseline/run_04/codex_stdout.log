{"type":"item.started","item":{"id":"item_37","type":"command_execution","command":"/usr/bin/bash -lc 'cat /workspace/app/worker.py && echo \"---\" && cat /workspace/app/admin_cli.py'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_37","type":"command_execution","command":"/usr/bin/bash -lc 'cat /workspace/app/worker.py && echo \"---\" && cat /workspace/app/admin_cli.py'","aggregated_output":"from app.repository import get_entry\n\n\ndef settle_entry(session_factory, external_id, fail_after_mark=False):\n    with session_factory() as session:\n        entry = get_entry(session, external_id)\n        entry.status = \"processing\"\n        session.flush()\n        if fail_after_mark:\n            session.rollback()\n            raise RuntimeError(\"boom\")\n        entry.status = \"settled\"\n        session.commit()\n\n\ndef settle_batch(session_factory, external_ids, fail_after_first=False):\n    with session_factory() as session:\n        for index, external_id in enumerate(external_ids):\n            entry = get_entry(session, external_id)\n            entry.status = \"processing\"\n            session.flush()\n            if fail_after_first and index == 0:\n                session.rollback()\n                raise RuntimeError(\"batch-boom\")\n            entry.status = \"settled\"\n        session.commit()\n---\nfrom app.repository import get_entry\n\n\ndef plan_batch(session_factory, external_id, dry_run=True):\n    with session_factory() as session:\n        entry = get_entry(session, external_id)\n        entry.status = \"queued\"\n        if dry_run:\n            session.rollback()\n            return {\"external_id\": external_id, \"dry_run\": True}\n        session.commit()\n        return {\"external_id\": external_id, \"dry_run\": False}\n\n\ndef reconcile_batch(session_factory, external_ids, dry_run=True, fail_after_first=False):\n    with session_factory() as session:\n        results = []\n        for index, external_id in enumerate(external_ids):\n            entry = get_entry(session, external_id)\n            entry.status = \"queued\"\n            results.append({\"external_id\": external_id, \"dry_run\": dry_run})\n            if fail_after_first and index == 0:\n                session.rollback()\n                raise RuntimeError(\"cli-boom\")\n        if dry_run:\n            session.rollback()\n        else:\n            session.commit()\n        return results\n","exit_code":0,"status":"completed"}}
