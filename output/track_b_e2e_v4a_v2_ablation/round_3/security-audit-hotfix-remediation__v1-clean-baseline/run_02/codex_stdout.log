aths\": [\n        \"audit/audit.sarif\",\n        \"audit/appsec_review.md\"\n      ]\n    },\n    {\n      \"artifact_id\": \"APPSEC-KEY-03\",\n      \"source\": \"appsec\",\n      \"rule_or_file\": \"repo/export_api/auth.py\",\n      \"affected_path\": \"repo/export_api/auth.py\",\n      \"disposition\": \"deferred\",\n      \"rationale\": \"JWT key rotation deferred per appsec_review.md: rotate JWT material later; do not fold into this hotfix.\",\n      \"evidence_paths\": [\n        \"audit/appsec_review.md\",\n        \"audit/triage_matrix.csv\"\n      ]\n    }\n  ]\n}\n\n=== deploy_hotfix.json ===\n{\n  \"schema_version\": \"cnb55.deploy_hotfix.v1\",\n  \"variant_id\": \"cnb55.path-traversal.hotfix.2026.05.15\",\n  \"rollback_trigger\": \"Any regression in nested export paths (e.g., reports/partner-billing/2026-04/export.csv) or increase in 403 errors on legitimate export requests.\",\n  \"impact_scope\": \"export_api/storage.py: _normalize_requested_path now iteratively decodes percent-encoded input until stable; resolve_export_path now checks for absolute paths before stripping, uses split-based component detection for traversal, and verifies containment via Path.relative_to().\",\n  \"operator_verification_steps\": [\n    \"Confirm all existing tests pass: make test\",\n    \"Validate the hotfix artifacts: python3 bin/cnb55-hotfix-artifacts validate audit/triage_note.json repo/ops/deploy_hotfix.json\",\n    \"Test legitimate nested export path works: reports/partner-billing/2026-04/export.csv\",\n    \"Test encoded traversal is blocked: ..%2fsecrets.csv\",\n    \"Test double-encoded traversal is blocked: %252e%252e%252fsecrets.csv\",\n    \"Test mixed slash traversal is blocked: reports\\\\..\\\\..\\\\secrets.csv\",\n    \"Test absolute path is blocked: /etc/passwd\",\n    \"Test drive-qualified path is blocked: C:\\\\temp\\\\secrets.csv\"\n  ],\n  \"behavior_preservation_claims\": [\n    {\"sample_id\": \"REQ-legit-nested\", \"expected\": \"allowed\", \"v