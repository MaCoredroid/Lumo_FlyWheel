ence\": [\"corpus/timeline/incident_timeline.md\", \"corpus/tickets/TICKET-8729.md\"]\n    },\n    {\n      \"finding\": \"idempotency-required guardrail skipped for legacy_batch_header\",\n      \"confidence\": \"high\",\n      \"evidence\": [\"corpus/timeline/incident_timeline.md\"]\n    },\n    {\n      \"finding\": \"reject bulk-refund requests without idempotency keys and remove legacy_batch_header bypass\",\n      \"confidence\": \"high\",\n      \"evidence\": [\"corpus/remediation/notes.md\"]\n    }\n  ],\n  \"unresolved_ambiguity\": \"worker replay was an early symptom theory but is not supported as the primary trigger by final evidence\"\n}\n","exit_code":0,"status":"completed"}}
