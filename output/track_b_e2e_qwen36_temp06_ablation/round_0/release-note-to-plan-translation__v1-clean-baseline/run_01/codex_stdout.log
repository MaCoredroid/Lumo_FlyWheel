{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/usr/bin/bash -lc \"cat > /workspace/brief_input.json << 'EOF'\n{\n  \\\"schema_version\\\": \\\"cnb55.release_plan_brief.v1\\\",\n  \\\"variant_id\\\": \\\"v1-clean-baseline\\\",\n  \\\"first_milestone_id\\\": \\\"RN-101\\\",\n  \\\"ordered_steps\\\": [\n    {\n      \\\"step_id\\\": \\\"RN-101\\\",\n      \\\"rank\\\": 1,\n      \\\"title\\\": \\\"Audit translator schema drift\\\",\n      \\\"summary\\\": \\\"Audit the translator schema drift before removing the legacy parser shim. The shim currently masks drift in local smoke runs, so this step surfaces the real schema state.\\\",\n      \\\"bounded_deliverable\\\": \\\"Schema drift audit report with list of drifted fields and shim removal plan.\\\",\n      \\\"evidence\\\": \\\"repo_state.md notes legacy parser shim masks schema drift; dependency_map.md says dashboard consumes step-id schema from translator.\\\"\n    },\n    {\n      \\\"step_id\\\": \\\"RN-102\\\",\n      \\\"rank\\\": 2,\n      \\\"title\\\": \\\"Backfill dependency-graph fixtures\\\",\n      \\\"summary\\\": \\\"Backfill dependency-graph fixtures so the plan contract catches ordering regressions. Tests currently fail when new step ids are introduced without fixture updates.\\\",\n      \\\"bounded_deliverable\\\": \\\"Updated fixtures that pass plan_contract.py with the new schema step ids.\\\",\n      \\\"evidence\\\": \\\"test_inventory.md reports plan_contract.py fails without fixture updates; dependency_map.md says dashboard must not ship until fixtures reflect new schema.\\\"\n    },\n    {\n      \\\"step_id\\\": \\\"RN-103\\\",\n      \\\"rank\\\": 3,\n      \\\"title\\\": \\\"Enable dashboard summary behind kill switch\\\",\n      \\\"summary\\\": \\\"Enable the translated release-plan dashboard summary behind a kill switch after the schema is stable and fixtures are backfilled. The dashboard is user-visible.\\\",\n      \\\"bounded_deliverable\\\": \\\"Dashboard summary enabled behind kill switch with canary coverage.\\\",\n      \\\"evidence\\\": \\\"repo_state.md confirms dashboard is user-visible; dependency_map.md says dashboard consumes step-id schema and must not ship until fixtures reflect new schema.\\\"\n    },\n    {\n      \\\"step_id\\\": \\\"RN-104\\\",\n      \\\"rank\\\": 4,\n      \\\"title\\\": \\\"Update operator runbook and launch checklist\\\",\n      \\\"summary\\\": \\\"Update the operator runbook and launch checklist after the summary path is proven in canary. The runbook only stabilizes after rollout and rollback shape are known.\\\",\n      \\\"bounded_deliverable\\\": \\\"Updated runbook and launch checklist reflecting proven canary rollout/rollback procedures.\\\",\n      \\\"evidence\\\": \\\"dependency_map.md states runbook only stabilizes after rollout and rollback shape are known.\\\"\n    }\n  ],\n  \\\"dependency_notes\\\": [\n    {\n      \\\"before\\\": \\\"RN-101\\\",\n      \\\"after\\\": \\\"RN-102\\\",\n      \\\"reason\\\": \\\"Fixtures must reflect the audited schema; backfilling before the audit would use stale schema definitions.\\\"\n    },\n    {\n      \\\"before\\\": \\\"RN-101\\\",\n      \\\"after\\\": \\\"RN-103\\\",\n      \\\"reason\\\": \\\"Dashboard summary consumes the step-id schema produced by the translator; schema must be stable first.\\\"\n    },\n    {\n      \\\"before\\\": \\\"RN-102\\\",\n      \\\"after\\\": \\\"RN-103\\\",\n      \\\"reason\\\": \\\"Dashboard must not ship until dependency-graph fixtures reflect the new schema, otherwise plan_contract.py will fail on ordering regressions.\\\"\n    },\n    {\n      \\\"before\\\": \\\"RN-103\\\",\n      \\\"after\\\": \\\"RN-104\\\",\n      \\\"reason\\\": \\\"Runbook and launch checklist require the dashboard summary path to be proven in canary so rollout and rollback shapes are known.\\\"\n    }\n  ],\n  \\\"primary_risk\\\": {\n    \\\"statement\\\": \\\"Dashboard renders incorrect step ordering to users if shipped before schema audit and fixture backfill are complete.\\\",\n    \\\"evidence\\\": [\n      \\\"repo_state.md: dashboard is user-visible and renders whatever order the translator emits\\\",\n      \\\"dependency_map.md: dashboard must not ship until fixtures reflect the new schema\\\",\n      \\\"test_inventory.md: no canary coverage for bad dependency ordering\\\"\n    ],\n    \\\"mitigations\\\": [\n      \\\"Keep dashboard behind a kill switch (RN-103) until schema and fixtures are verified.\\\",\n      \\\"Run plan_contract.py after fixture backfill to confirm ordering regressions are caught.\\\",\n      \\\"Gate runbook update (RN-104) behind successful canary proof of the summary path.\\\"\n    ]\n  },\n  \\\"assumption_ledger\\\": [\n    {\n      \\\"topic\\\": \\\"Legacy parser shim removal timeline\\\",\n      \\\"status\\\": \\\"missing\\\",\n      \\\"note\\\": \\\"RN-101 audits drift before shim removal, but the actual shim removal date and rollback plan are not specified in any release note or repo inventory.\\\"\n    },\n    {\n      \\\"topic\\\": \\\"Canary rollout criteria for dashboard\\\",\n      \\\"status\\\": \\\"assumed\\\",\n      \\\"note\\\": \\\"Assuming canary proof means the dashboard summary renders correct step ordering for at least one full release cycle without kill-switch intervention.\\\"\n    },\n    {\n      \\\"topic\\\": \\\"Schema drift severity\\\",\n      \\\"status\\\": \\\"assumed\\\",\n      \\\"note\\\": \\\"Assuming the masked schema drift is non-breaking but produces silently wrong ordering; if drift is breaking, RN-101 scope expands.\\\"\n    }\n  ]\n}\nEOF\necho \\\"Written brief_input.json\\\"\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
