\n    },\n    {\n      \\\"flag\\\": \\\"PREVIEW_FORCE_LEGACY\\\",\n      \\\"action\\\": \\\"remove_after_migration\\\",\n      \\\"rationale\\\": \\\"Dead flag — parser sets a reporting-only field that no runtime branch reads. Safe to remove after confirming no external tooling reads force_legacy_seen.\\\",\n      \\\"blockers\\\": [\n        \\\"Confirm no external tooling depends on force_legacy_seen reporting\\\"\n      ]\n    }\n  ],\n  \\\"assumption_ledger\\\": [\n    {\n      \\\"status\\\": \\\"observed\\\",\n      \\\"topic\\\": \\\"ENABLE_SHADOW_PREVIEW runtime branch\\\",\n      \\\"note\\\": \\\"Confirmed in runtime.py preview_runtime_branch function\\\"\n    },\n    {\n      \\\"status\\\": \\\"observed\\\",\n      \\\"topic\\\": \\\"ENABLE_PREVIEW_V2 alias normalization\\\",\n      \\\"note\\\": \\\"Confirmed in config.py elif branch and runbook documentation\\\"\n    },\n    {\n      \\\"status\\\": \\\"missing\\\",\n      \\\"topic\\\": \\\"External tooling consuming force_legacy_seen\\\",\n      \\\"note\\\": \\\"No evidence of external consumers found in this workspace copy\\\"\n    }\n  ]\n}\nENDJSON\necho \\\"brief_input.json rewritten\\\"\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
