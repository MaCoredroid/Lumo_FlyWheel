{"type":"item.completed","item":{"id":"item_56","type":"command_execution","command":"/usr/bin/bash -lc 'cd /workspace && cat -n repo/export_api/storage.py'","aggregated_output":"     1\tfrom __future__ import annotations\n     2\t\n     3\timport re\n     4\tfrom pathlib import Path\n     5\tfrom urllib.parse import unquote\n     6\t\n     7\t\n     8\tclass ExportPathViolation(ValueError):\n     9\t    pass\n    10\t\n    11\t\n    12\tdef _normalize_requested_path(requested_path: str) -> str:\n    13\t    if not isinstance(requested_path, str) or not requested_path:\n    14\t        raise ExportPathViolation(\"requested_path must be a non-empty string\")\n    15\t    normalized = unquote(unquote(requested_path)).replace(\"\\\\\", \"/\")\n    16\t    while \"//\" in normalized:\n    17\t        normalized = normalized.replace(\"//\", \"/\")\n    18\t    if normalized.startswith(\"/\"):\n    19\t        raise ExportPathViolation(\"absolute paths are not allowed\")\n    20\t    normalized = normalized.lstrip(\"/\")\n    21\t    if re.match(r\"^[A-Za-z]:\", normalized):\n    22\t        raise ExportPathViolation(\"drive-qualified paths are not allowed\")\n    23\t    return normalized\n    24\t\n    25\t\n    26\tdef resolve_export_path(tenant_root: Path, requested_path: str) -> Path:\n    27\t    normalized = _normalize_requested_path(requested_path)\n    28\t    if \"..\" in normalized:\n    29\t        raise ExportPathViolation(\"blocked suspicious export path\")\n    30\t    candidate = (tenant_root / normalized).resolve(strict=False)\n    31\t    if not str(candidate).startswith(str(tenant_root.resolve())):\n    32\t        raise ExportPathViolation(\"candidate escaped the tenant root\")\n    33\t    return candidate\n","exit_code":0,"status":"completed"}}
