{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/usr/bin/bash -lc 'cat /workspace/bin/cnb55-brief'","aggregated_output":"#!/usr/bin/env python3\n\"\"\"\nFamily-local structured-output CLI for `policy-aware-request-resolution`.\n\nAgents author `brief_input.json`, validate it, then submit it:\n\n  ./bin/cnb55-brief schema\n  ./bin/cnb55-brief validate brief_input.json\n  ./bin/cnb55-brief submit brief_input.json\n\n`submit` writes:\n  - brief/manager_brief.json\n  - brief/manager_brief.md\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport re\nimport sys\nfrom pathlib import Path\nfrom typing import Any\n\nSCHEMA_VERSION = \"cnb55.manager_brief.v2\"\nCONSTRAINT_TAGS = (\n    \"policy\",\n    \"privacy\",\n    \"security\",\n    \"operational\",\n    \"release\",\n    \"incident\",\n)\nASSUMPTION_STATUSES = (\"observed\", \"to_verify\", \"missing\")\nMITIGATION_KEYWORDS = (\n    \"expiry\",\n    \"audit log\",\n    \"redact\",\n    \"redaction\",\n    \"least privilege\",\n    \"ticket\",\n    \"rollback\",\n)\nEVIDENCE_ROOTS = (\"proposals\", \"repo_evidence\", \"release_context\", \"incident_context\")\n\n\ndef schema_object() -> dict[str, Any]:\n    return {\n        \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n        \"title\": \"CNB-55 Policy Resolution Brief Input\",\n        \"type\": \"object\",\n        \"required\": [\n            \"schema_version\",\n            \"variant_id\",\n            \"accepted\",\n            \"primary_risk\",\n            \"ranking\",\n            \"assumption_ledger\",\n        ],\n        \"additionalProperties\": False,\n        \"properties\": {\n            \"schema_version\": {\"type\": \"string\", \"const\": SCHEMA_VERSION},\n            \"variant_id\": {\"type\": \"string\", \"minLength\": 1},\n            \"accepted\": {\"type\": \"string\", \"pattern\": \"^P[0-9]+$\"},\n            \"primary_risk\": {\n                \"type\": \"object\",\n                \"required\": [\"statement\", \"mitigations\"],\n                \"additionalProperties\": False,\n                \"properties\": {\n                    \"statement\": {\"type\": \"string\", \"minLength\": 24},\n                    \"mitigations\": {\n                        \"type\": \"array\",\n                        \"minItems\": 2,\n                        \"items\": {\"type\": \"string\", \"minLength\": 3},\n                    },\n                },\n            },\n            \"ranking\": {\n                \"type\": \"array\",\n                \"minItems\": 2,\n                \"items\": {\n                    \"type\": \"object\",\n                    \"required\": [\n                        \"proposal_id\",\n                        \"rank\",\n                        \"summary\",\n                        \"citations\",\n                        \"constraint_tags\",\n                    ],\n                    \"additionalProperties\": False,\n                    \"properties\": {\n                        \"proposal_id\": {\"type\": \"string\", \"pattern\": \"^P[0-9]+$\"},\n                        \"rank\": {\"type\": \"integer\", \"minimum\": 1},\n                        \"summary\": {\"type\": \"string\", \"minLength\": 16},\n                        \"citations\": {\n                            \"type\": \"array\",\n                            \"items\": {\"type\": \"string\", \"minLength\": 1},\n                        },\n                        \"constraint_tags\": {\n                            \"type\": \"array\",\n                            \"items\": {\"enum\": list(CONSTRAINT_TAGS)},\n                        },\n                    },\n                },\n            },\n            \"assumption_ledger\": {\n                \"type\": \"array\",\n                \"minItems\": 1,\n                \"items\": {\n                    \"type\": \"object\",\n                    \"required\": [\"topic\", \"status\", \"note\"],\n                    \"additionalProperties\": False,\n                    \"properties\": {\n                        \"topic\": {\"type\": \"string\", \"minLength\": 3},\n                        \"status\": {\"enum\": list(ASSUMPTION_STATUSES)},\n                        \"note\": {\"type\": \"string\", \"minLength\": 3},\n                    },\n                },\n            },\n        },\n    }\n\n\nclass ValidationError(Exception):\n    def __init__(self, code: int, messages: list[str]):\n        super().__init__(\"\\n\".join(messages))\n        self.code = code\n        self.messages = messages\n\n\ndef _load_json(path: Path) -> Any:\n    try:\n        return json.loads(path.read_text(encoding=\"utf-8\"))\n    except FileNotFoundError:\n        raise ValidationError(2, [f\"input file not found: {path}\"]) from None\n    except json.JSONDecodeError as exc:\n        raise ValidationError(2, [f\"input file is not valid JSON: {exc}\"]) from None\n\n\ndef _type_ok(value: Any, kind: str) -> bool:\n    if kind == \"object\":\n        return isinstance(value, dict)\n    if kind == \"array\":\n        return isinstance(value, list)\n    if kind == \"string\":\n        return isinstance(value, str)\n    if kind == \"integer\":\n        return isinstance(value, int) and not isinstance(value, bool)\n    return False\n\n\ndef validate_schema(doc: Any) -> list[str]:\n    errors: list[str] = []\n    if not isinstance(doc, dict):\n        return [\"top-level value must be a JSON object\"]\n\n    required = set(schema_object()[\"required\"])\n    missing = sorted(required - set(doc))\n    extra = sorted(set(doc) - required)\n    for field in missing:\n        errors.append(f\"missing required field: {field}\")\n    for field in extra:\n        errors.append(f\"unexpected top-level field: {field}\")\n    if missing or extra:\n        return errors\n\n    if doc[\"schema_version\"] != SCHEMA_VERSION:\n        errors.append(f\"schema_version must equal {SCHEMA_VERSION}\")\n    if not _type_ok(doc[\"variant_id\"], \"string\") or not doc[\"variant_id\"].strip():\n        errors.append(\"variant_id must be a non-empty string\")\n    if not _type_ok(doc[\"accepted\"], \"string\") or not re.match(r\"^P[0-9]+$\", doc[\"accepted\"]):\n        errors.append(\"accepted must match ^P[0-9]+$\")\n\n    primary_risk = doc[\"primary_risk\"]\n    if not _type_ok(primary_risk, \"object\"):\n        errors.append(\"primary_risk must be an object\")\n    else:\n        if set(primary_risk) != {\"statement\", \"mitigations\"}:\n            errors.append(\"primary_risk must contain exactly statement and mitigations\")\n        statement = primary_risk.get(\"statement\")\n        if not _type_ok(statement, \"string\") or len(statement.strip()) < 24:\n            errors.append(\"primary_risk.statement must be a string >=24 chars\")\n        mitigations = primary_risk.get(\"mitigations\")\n        if not _type_ok(mitigations, \"array\") or len(mitigations) < 2:\n            errors.append(\"primary_risk.mitigations must contain at least two strings\")\n        elif not all(_type_ok(item, \"string\") and item.strip() for item in mitigations):\n            errors.append(\"every mitigation must be a non-empty string\")\n\n    ranking = doc[\"ranking\"]\n    if not _type_ok(ranking, \"array\") or len(ranking) < 2:\n        errors.append(\"ranking must be a list with at least two entries\")\n    else:\n        seen_ids: set[str] = set()\n        seen_ranks: set[int] = set()\n        for idx, entry in enumerate(ranking):\n            if not _type_ok(entry, \"object\"):\n                errors.append(f\"ranking[{idx}] must be an object\")\n                continue\n            required_entry = {\"proposal_id\", \"rank\", \"summary\", \"citations\", \"constraint_tags\"}\n            if set(entry) != required_entry:\n                errors.append(\n                    f\"ranking[{idx}] must contain exactly {sorted(required_entry)}\"\n                )\n                continue\n            pid = entry[\"proposal_id\"]\n            if not _type_ok(pid, \"string\") or not re.match(r\"^P[0-9]+$\", pid):\n                errors.append(f\"ranking[{idx}].proposal_id must match ^P[0-9]+$\")\n            elif pid in seen_ids:\n                errors.append(f\"proposal_id {pid} appears more than once\")\n            else:\n                seen_ids.add(pid)\n            rank = entry[\"rank\"]\n            if not _type_ok(rank, \"integer\") or rank < 1:\n                errors.append(f\"ranking[{idx}].rank must be an integer >=1\")\n            elif rank in seen_ranks:\n                errors.append(f\"rank {rank} appears more than once\")\n            else:\n                seen_ranks.add(rank)\n            summary = entry[\"summary\"]\n            if not _type_ok(summary, \"string\") or len(summary.strip()) < 16:\n                errors.append(f\"ranking[{idx}].summary must be a string >=16 chars\")\n            citations = entry[\"citations\"]\n            if not _type_ok(citations, \"array\"):\n                errors.append(f\"ranking[{idx}].citations must be an array\")\n            elif not all(_type_ok(c, \"string\") and c.strip() for c in citations):\n                errors.append(f\"ranking[{idx}].citations must contain non-empty strings\")\n            tags = entry[\"constraint_tags\"]\n            if not _type_ok(tags, \"array\"):\n                errors.append(f\"ranking[{idx}].constraint_tags must be an array\")\n            elif not all(tag in CONSTRAINT_TAGS for tag in tags):\n                errors.append(\n                    f\"ranking[{idx}].constraint_tags must be in {', '.join(CONSTRAINT_TAGS)}\"\n                )\n\n        contiguous = set(range(1, len(ranking) + 1))\n        if seen_ranks and seen_ranks != contiguous:\n            errors.append(f\"ranks must be contiguous 1..{len(ranking)}\")\n        top_rank = next((e for e in ranking if e.get(\"rank\") == 1), None)\n        if not isinstance(top_rank, dict) or top_rank.get(\"proposal_id\") != doc[\"accepted\"]:\n            errors.append(\"accepted must equal the proposal_id of the rank=1 entry\")\n\n    ledger = doc[\"assumption_ledger\"]\n    if not _type_ok(ledger, \"array\") or not ledger:\n        errors.append(\"assumption_ledger must be a non-empty array\")\n    else:\n        has_missing = False\n        for idx, row in enumerate(ledger):\n            if not _type_ok(row, \"object\"):\n                errors.append(f\"assumption_ledger[{idx}] must be an object\")\n                continue\n            if set(row) != {\"topic\", \"status\", \"note\"}:\n                errors.append(f\"assumption_ledger[{idx}] must contain topic/status/note only\")\n                continue\n            topic = row[\"topic\"]\n            note = row[\"note\"]\n            status = row[\"status\"]\n            if not _type_ok(topic, \"string\") or len(topic.strip()) < 3:\n                errors.append(f\"assumption_ledger[{idx}].topic must be a string >=3 chars\")\n            if status not in ASSUMPTION_STATUSES:\n                errors.append(\n                    f\"assumption_ledger[{idx}].status must be one of {ASSUMPTION_STATUSES}\"\n                )\n            if not _type_ok(note, \"string\") or len(note.strip()) < 3:\n                errors.append(f\"assumption_ledger[{idx}].note must be a string >=3 chars\")\n            has_missing = has_missing or status == \"missing\"\n        if not has_missing:\n            errors.append(\"assumption_ledger must include at least one row with status=missing\")\n    return errors\n\n\ndef validate_workspace(doc: dict[str, Any], workspace: Path) -> list[str]:\n    errors: list[str] = []\n    variant_path = workspace / \".scenario_variant\"\n    if variant_path.exists():\n        variant_id = variant_path.read_text(encoding=\"utf-8\").strip()\n        if doc.get(\"variant_id\") != variant_id:\n            errors.append(\n                f\"variant_id mismatch: input={doc.get('variant_id')!r}, workspace={variant_id!r}\"\n            )\n\n    ranking = doc.get(\"ranking\", [])\n    for idx, entry in enumerate(ranking):\n        for citation in entry.get(\"citations\", []):\n            candidate = citation.lstrip(\"./\")\n            if not any(candidate == root or candidate.startswith(root + \"/\") for root in EVIDENCE_ROOTS):\n                errors.append(\n                    f\"ranking[{idx}].citations contains path outside allowed roots: {citation}\"\n                )\n                continue\n            if not (workspace / candidate).exists():\n                errors.append(f\"ranking[{idx}].citations path does not exist: {citation}\")\n    return errors\n\n\ndef render_markdown(doc: dict[str, Any]) -> str:\n    accepted = doc[\"accepted\"]\n    lines = [\n        f\"# Policy Resolution Brief — {doc['variant_id']}\",\n        \"\",\n        f\"Accepted resolution: `{accepted}`\",\n        \"\",\n        \"## Ranked Options\",\n        \"\",\n    ]\n    for entry in sorted(doc[\"ranking\"], key=lambda item: item[\"rank\"]):\n        lines.extend(\n            [\n                f\"### {entry['rank']}. {entry['proposal_id']}\",\n                entry[\"summary\"],\n                \"\",\n                f\"- Constraint tags: {', '.join(entry['constraint_tags']) or 'none'}\",\n                f\"- Citations: {', '.join(entry['citations']) or 'none'}\",\n                \"\",\n            ]\n        )\n    lines.extend(\n        [\n            \"## Primary Risk\",\n            \"\",\n            doc[\"primary_risk\"][\"statement\"],\n            \"\",\n            \"Mitigations:\",\n        ]\n    )\n    for item in doc[\"primary_risk\"][\"mitigations\"]:\n        lines.append(f\"- {item}\")\n    lines.extend([\"\", \"## Assumption Ledger\", \"\"])\n    for row in doc[\"assumption_ledger\"]:\n        lines.append(f\"- `{row['status']}` {row['topic']}: {row['note']}\")\n    lines.extend(\n        [\n            \"\",\n            \"## Resolution Note\",\n            \"\",\n            f\"The selected path is `{accepted}` because it best satisfies the current policy and operating context for `{doc['variant_id']}`.\",\n            \"\",\n        ]\n    )\n    return \"\\n\".join(lines)\n\n\ndef _handle_validate_or_submit(input_path: Path, submit: bool) -> int:\n    doc = _load_json(input_path)\n    errors = validate_schema(doc)\n    errors.extend(validate_workspace(doc, Path.cwd()))\n    if errors:\n        raise ValidationError(3 if any(\"schema\" in e or \"missing\" in e or \"must\" in e for e in errors) else 4, errors)\n\n    if not submit:\n        return 0\n\n    out_dir = Path(\"brief\")\n    out_dir.mkdir(parents=True, exist_ok=True)\n    json_path = out_dir / \"manager_brief.json\"\n    md_path = out_dir / \"manager_brief.md\"\n    payload = json.dumps(doc, indent=2, sort_keys=True) + \"\\n\"\n    json_path.write_text(payload, encoding=\"utf-8\")\n    md_path.write_text(render_markdown(doc), encoding=\"utf-8\")\n    return 0\n\n\ndef build_parser() -> argparse.ArgumentParser:\n    parser = argparse.ArgumentParser(description=\"CNB-55 policy resolution brief CLI\")\n    sub = parser.add_subparsers(dest=\"command\", required=True)\n    sub.add_parser(\"schema\")\n    validate = sub.add_parser(\"validate\")\n    validate.add_argument(\"path\")\n    submit = sub.add_parser(\"submit\")\n    submit.add_argument(\"path\")\n    return parser\n\n\ndef main(argv: list[str] | None = None) -> int:\n    args = build_parser().parse_args(argv)\n    try:\n        if args.command == \"schema\":\n            print(json.dumps(schema_object(), indent=2, sort_keys=True))\n            return 0\n        if args.command == \"validate\":\n            return _handle_validate_or_submit(Path(args.path), submit=False)\n        if args.command == \"submit\":\n            return _handle_validate_or_submit(Path(args.path), submit=True)\n        raise AssertionError(f\"unexpected command {args.command!r}\")\n    except ValidationError as exc:\n        for msg in exc.messages:\n            print(msg, file=sys.stderr)\n        return exc.code\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n","exit_code":0,"status":"completed"}}
