fter confirming no external deploy manifests still reference it.'\n        }\n    ],\n    'assumption_ledger': [\n        {\n            'status': 'observed',\n            'topic': 'ENABLE_SHADOW_PREVIEW runtime branch',\n            'note': 'Confirmed via config.py parser and runtime.py branch logic.'\n        },\n        {\n            'status': 'observed',\n            'topic': 'ENABLE_PREVIEW_V2 alias normalization',\n            'note': 'Parser normalizes V2 to shadow_enabled; no standalone branch exists.'\n        },\n        {\n            'status': 'missing',\n            'topic': 'External deploy manifest references to PREVIEW_FORCE_LEGACY',\n            'note': 'Cannot verify from workspace alone whether external manifests still set this flag.'\n        }\n    ]\n}\n\nwith open('/workspace/brief_input.json', 'w') as f:\n    json.dump(doc, f, indent=2)\nprint('brief_input.json written')\n\\\"\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
