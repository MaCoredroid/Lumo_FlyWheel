{"type":"item.completed","item":{"id":"item_110","type":"command_execution","command":"/usr/bin/bash -lc 'cd /workspace && git show HEAD -- repo/export_api/storage.py'","aggregated_output":"commit fb1b7feec5a285b45d7d2d47025e8f7af2114f2e\nAuthor: Codex Agent <agent@codex-cli>\nDate:   Wed May 20 17:58:50 2026 +0000\n\n    hotfix: fix export-path traversal via double-encoded payloads (APPSEC-EXP-17)\n    \n    - Repeated unquote() until stable in _normalize_requested_path to catch\n      double-encoded traversal (%252e%252e%252f) and triple-encoded parent segments\n    - Check for absolute (/) and drive-letter (C:) paths before lstrip('/') strips them\n    - Add triage note, deploy hotfix note, and regression tests\n\ndiff --git a/repo/export_api/storage.py b/repo/export_api/storage.py\nnew file mode 100644\nindex 0000000..b992d65\n--- /dev/null\n+++ b/repo/export_api/storage.py\n@@ -0,0 +1,40 @@\n+from __future__ import annotations\n+\n+import re\n+from pathlib import Path\n+from urllib.parse import unquote\n+\n+\n+class ExportPathViolation(ValueError):\n+    pass\n+\n+\n+_DRIVE_LETTER_RE = re.compile(r\"^[a-zA-Z]:\")\n+\n+\n+def _normalize_requested_path(requested_path: str) -> str:\n+    if not isinstance(requested_path, str) or not requested_path:\n+        raise ExportPathViolation(\"requested_path must be a non-empty string\")\n+    normalized = requested_path\n+    while True:\n+        decoded = unquote(normalized)\n+        if decoded == normalized:\n+            break\n+        normalized = decoded\n+    # Check for absolute / drive-qualified paths BEFORE normalizing separators\n+    if normalized.startswith(\"/\") or _DRIVE_LETTER_RE.match(normalized):\n+        raise ExportPathViolation(\"blocked absolute or drive-qualified path\")\n+    normalized = normalized.replace(\"\\\\\", \"/\")\n+    while \"//\" in normalized:\n+        normalized = normalized.replace(\"//\", \"/\")\n+    return normalized.lstrip(\"/\")\n+\n+\n+def resolve_export_path(tenant_root: Path, requested_path: str) -> Path:\n+    normalized = _normalize_requested_path(requested_path)\n+    if \"..\" in normalized:\n+        raise ExportPathViolation(\"blocked suspicious export path\")\n+    candidate = (tenant_root / normalized).resolve(strict=False)\n+    if not str(candidate).startswith(str(tenant_root.resolve())):\n+        raise ExportPathViolation(\"candidate escaped the tenant root\")\n+    return candidate\n","exit_code":0,"status":"completed"}}
