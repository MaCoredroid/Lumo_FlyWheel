{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/usr/bin/bash -lc \"cat > /workspace/brief_input.json << 'ENDOF /workspace/brief_input.json << 'EOF'\n{\n  \\\"schema_version\\\": \\\"cnb55.release_plan_brief.v1\\\",\n  \\\"variant_id\\\": \\\"v1-clean-baseline\\\",\n  \\\"first_milestone_id\\\": \\\"RN-101\\\",\n  \\\"ordered_steps\\\": [\n    {\n      \\\"step_id\\\": \\\"RN-101\\\",\n      \\\"rank\\\": 1,\n      \\\"title\\\": \\\"Audit translator schema drift & remove legacy parser shim\\\",\n      \\\"summary\\\": \\\"Audit and fix the translator schema drift that the legacy parser shim currently masks in local smoke runs. Removing the shim exposes the real schema state so downstream work builds on correct data.\\\",\n      \\\"bounded_deliverable\\\": \\\"Schema drift audit report with shim removal, passing local smoke runs against the new schema.\\\",\n      \\\"evidence\\\": \\\"repo_state.md notes legacy shim masks schema drift; dependency_map.md says dashboard consumes translator step-id schema\\\"\n    },\n    {\n      \\\"step_id\\\": \\\"RN-102\\\",\n      \\\"rank\\\": 2,\n      \\\"title\\\": \\\"Backfill dependency-graph fixtures\\\",\n      \\\"summary\\\": \\\"Backfill the dependency-graph fixtures so the plan contract test catches ordering regressions with the new step ids from the corrected schema.\\\",\n      \\\"bounded_deliverable\\\": \\\"Updated fixtures that make tests/plan_contract.py pass with new step ids.\\\",\n      \\\"evidence\\\": \\\"test_inventory.md shows plan_contract.py fails without fixture updates; dependency_map.md requires fixtures before dashboard ships\\\"\n    },\n    {\n      \\\"step_id\\\": \\\"RN-103\\\",\n      \\\"rank\\\": 3,\n      \\\"title\\\": \\\"Enable dashboard summary behind kill switch\\\",\n      \\\"summary\\\": \\\"Enable the translated release-plan dashboard summary behind a kill switch now that the schema is stable and fixtures are in place. Canary coverage already exists for the dashboard.\\\",\n      \\\"bounded_deliverable\\\": \\\"Dashboard summary feature flag behind kill switch, canary-validated.\\\",\n      \\\"evidence\\\": \\\"dependency_map.md says dashboard must not ship until fixtures reflect new schema; repo_state.md confirms dashboard is user-visible\\\"\n    },\n    {\n      \\\"step_id\\\": \\\"RN-104\\\",\n      \\\"rank\\\": 4,\n      \\\"title\\\": \\\"Update operator runbook and launch checklist\\\",\n      \\\"summary\\\": \\\"Update the operator runbook and launch checklist now that the summary path is proven in canary and the rollout/rollback shape is known.\\\",\n      \\\"bounded_deliverable\\\": \\\"Updated runbook and launch checklist reflecting proven rollout and rollback procedures.\\\",\n      \\\"evidence\\\": \\\"dependency_map.md says runbook only stabilizes after rollout and rollback shape are known\\\"\n    }\n  ],\n  \\\"dependency_notes\\\": [\n    {\n      \\\"before\\\": \\\"RN-101\\\",\n      \\\"after\\\": \\\"RN-102\\\",\n      \\\"reason\\\": \\\"Fixtures must reflect the corrected schema; backfilling before the schema audit would use stale step ids.\\\"\n    },\n    {\n      \\\"before\\\": \\\"RN-101\\\",\n      \\\"after\\\": \\\"RN-103\\\",\n      \\\"reason\\\": \\\"Dashboard consumes the translator step-id schema; enabling it before schema stabilization risks rendering incorrect plan order to users.\\\"\n    },\n    {\n      \\\"before\\\": \\\"RN-102\\\",\n      \\\"after\\\": \\\"RN-103\\\",\n      \\\"reason\\\": \\\"Dependency map explicitly requires fixtures to reflect the new schema before the dashboard ships; otherwise plan_contract.py will fail on new step ids.\\\"\n    },\n    {\n      \\\"before\\\": \\\"RN-103\\\",\n      \\\"after\\\": \\\"RN-104\\\",\n      \\\"reason\\\": \\\"Runbook needs the proven rollout and rollback shape from the dashboard canary before it can be finalized.\\\"\n    }\n  ],\n  \\\"primary_risk\\\": {\n    \\\"statement\\\": \\\"Dashboard renders incorrect release-plan ordering to users if enabled before schema audit and fixture backfill are complete.\\\",\n    \\\"evidence\\\": \\\"repo_state.md confirms the release dashboard is user-visible and renders whatever order the translator emits; test_inventory.md shows no coverage for bad dependency ordering; dependency_map.md explicitly blocks dashboard until fixtures are ready.\\\",\n    \\\"mitigations\\\": [\n      \\\"Keep dashboard behind a kill switch (RN-103) so it can be disabled instantly if regressions appear.\\\",\n      \\\"Complete schema audit (RN-101) and fixture backfill (RN-102) before enabling the dashboard.\\\",\n      \\\"Rely on existing canary coverage for dashboard summary to catch regressions early.\\\"\n    ]\n  },\n  \\\"assumption_ledger\\\": [\n    {\n      \\\"topic\\\": \\\"Legacy parser shim removal\\\",\n      \\\"status\\\": \\\"assumed\\\",\n      \\\"note\\\": \\\"Assuming shim removal is safe once schema drift is audited and fixed; no evidence of other consumers depending on the shim.\\\"\n    },\n    {\n      \\\"topic\\\": \\\"Kill switch implementation\\\",\n      \\\"status\\\": \\\"missing\\\",\n      \\\"note\\\": \\\"No repo evidence about whether a kill-switch mechanism already exists for the dashboard; assuming one can be added or the existing feature flag is sufficient.\\\"\n    },\n    {\n      \\\"topic\\\": \\\"Canary environment readiness\\\",\n      \\\"status\\\": \\\"assumed\\\",\n      \\\"note\\\": \\\"Assuming canary environment is available and configured for dashboard summary validation; test_inventory.md mentions canary-only coverage but no deployment details.\\\"\n    }\n  ]\n}\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
