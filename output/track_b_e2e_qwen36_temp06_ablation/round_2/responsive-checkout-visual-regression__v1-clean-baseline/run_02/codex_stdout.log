{"type":"item.completed","item":{"id":"item_23","type":"command_execution","command":"/usr/bin/bash -lc 'cat /workspace/apps/storefront/styles/checkout.css'","aggregated_output":".checkout-shell {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) 320px;\n  gap: 24px;\n  max-width: 1120px;\n  margin: 0 auto;\n  padding: 32px;\n}\n\n.checkout-payment {\n  display: grid;\n  gap: 16px;\n}\n\n.checkout-payment input {\n  display: block;\n  width: 100%;\n  min-height: 40px;\n}\n\n.checkout-summary {\n  align-self: start;\n  position: sticky;\n  top: 24px;\n  border: 1px solid #d8dee8;\n  padding: 16px;\n  background: white;\n}\n\n.checkout-primary-cta {\n  min-height: 48px;\n}\n\n.checkout-mobile-bar {\n  display: none;\n}\n\n@media (max-width: 600px) {\n  .checkout-shell[data-preview-compact=\"true\"] {\n    display: block;\n    padding: 16px;\n    padding-bottom: 80px;\n  }\n\n  .checkout-shell[data-preview-compact=\"true\"] .checkout-summary {\n    position: sticky;\n    top: 0;\n    z-index: 2;\n    margin-bottom: 16px;\n  }\n\n  .checkout-shell[data-preview-compact=\"true\"] .checkout-mobile-bar {\n    display: flex;\n    position: fixed;\n    left: 0;\n    right: 0;\n    bottom: 0;\n    justify-content: space-between;\n    padding: 14px 16px;\n    background: white;\n    border-top: 1px solid #d8dee8;\n  }\n}\n","exit_code":0,"status":"completed"}}
