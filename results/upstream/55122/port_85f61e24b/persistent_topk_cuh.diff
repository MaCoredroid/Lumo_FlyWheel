+template <uint32_t MAX_K>
+struct FilteredTopKStorage {
+  alignas(128) int histogram[2][256 + 128];
+  alignas(128) int counter;
+  alignas(128) int threshold_bin;
+  alignas(128) int num_input[2];
+  alignas(128) int indices[MAX_K];
+  int last_remain;
