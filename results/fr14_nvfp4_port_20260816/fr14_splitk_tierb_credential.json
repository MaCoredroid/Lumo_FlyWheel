  "authority": "Mark, FR14 pass 64: live-A/B serving on a Tier-B credential; promoted-default only after exact16 QC parity",
  "bounds_evaluation": {
    "bounds": [
      {
        "bound": true,
        "id": "B1",
        "kind": "hard",
        "measured": {
          "all_cases_bitwise_identical": true,
          "cross_process_digests_identical": true
        },
        "name": "determinism_bitwise",
        "passed": true,
        "statement": "Every determinism case must be bitwise identical across all repeats within a process, AND the per-case output/LSE digests must be identical across independent processes."
      },
      {
        "bound": 0.9,
        "id": "B2",
        "kind": "threshold",
        "measured": 0.9330657958984375,
        "name": "output_ulp_concentration",
        "passed": true,
        "statement": "At least 90% of characterized output elements must agree with the incumbent within 2 ULP."
      },
      {
        "bound": 4.0,
        "id": "B3",
        "kind": "threshold",
        "measured": 1.3837837837837839,
        "name": "output_max_abs_delta",
        "passed": true,
        "statement": "The largest output disagreement with the incumbent must be at most 4 bf16 steps at the scale of the tensor's own maximum. Expressed scale-free as max_abs_delta <= 4 * 2^-8 * reference_max_abs, evaluated per case and taken at its worst."
      },
      {
        "bound": 8,
        "id": "B4",
        "kind": "threshold",
        "measured": 4,
        "name": "lse_max_ulp",
        "passed": true,
        "statement": "The fp32 log-sum-exp must agree with the incumbent within 8 ULP everywhere. LSE feeds the acceptance/rejection arithmetic, so it is held tighter than the bf16 output in relative terms."
      },
      {
        "bound": 0.0001,
        "id": "B5",
        "kind": "threshold",
        "measured": 3.814697265625e-06,
        "name": "lse_max_abs_delta",
        "passed": true,
        "statement": "Absolute LSE agreement, as a second check that does not depend on the ULP grid."
      },
      {
        "bound": 2,
        "bound_source": "argmax_flips_vs_exact_incumbent",
        "id": "B6",
        "kind": "comparative",
        "measured": 1,
        "name": "argmax_flips_vs_exact_no_worse_than_incumbent",
        "passed": true,
        "statement": "Against a float64 dense reference on the SAME probe cases, the candidate must disagree with the exact argmax no more often than the incumbent does. This is the bound that makes the arm-versus-arm flip rate interpretable: a disagreement between two approximations is not a defect unless the candidate is the worse approximation."
      },
      {
        "bound": 1.1,
        "id": "B7",
        "kind": "comparative",
        "measured": 0.9608395953312465,
        "name": "output_rms_vs_exact_ratio",
        "passed": true,
        "statement": "Candidate output RMS error against the float64 reference, divided by the incumbent's on the same case, at its worst. Catches a systematic bias that a ULP histogram would not: a kernel can be uniformly slightly wrong and still sit within 2 ULP everywhere."
      },
      {
        "bound": 1.1,
        "id": "B8",
        "kind": "comparative",
        "measured": 0.8386085577670528,
        "name": "lse_rms_vs_exact_ratio",
        "passed": true,
        "statement": "The same test on the log-sum-exp."
      },
      {
        "bound": 0,
        "id": "B9",
        "kind": "hard",
        "measured": 0,
        "name": "nonfinite_agreement",
        "passed": true,
        "statement": "No element may be finite in one arm and non-finite in the other, in output or LSE. A NaN or Inf that appears only under split-K is a defect, not a rounding difference, at any magnitude."
      }
    ],
    "bounds_passed": true
  },
