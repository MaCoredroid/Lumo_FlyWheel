+                        "heartbeat_sent", "stall_detected", "terminal_reason",
+                        "ts_first_byte", "elapsed_s")},
+                    separators=(",", ":"),
+                ) + "\n"
+            )
+            sys.stderr.flush()
+    except Exception:
+        pass
