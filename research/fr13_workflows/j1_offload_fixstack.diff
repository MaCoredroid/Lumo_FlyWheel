+        while True:
+            try:
+                kind, val = q.get(timeout=heartbeat_s)
+            except queue.Empty:
+                yield _SSE_HEARTBEAT_TICK
+                continue
+            if kind == "chunk":
+                yield val
+            elif kind == "exc":
+                raise val
+            else:
+                return
