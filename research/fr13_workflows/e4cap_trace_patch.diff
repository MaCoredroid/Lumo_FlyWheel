+        "                    self,\n"
+        "                    attn_metadata,\n"
+        "                    non_spec_state_indices_tensor,\n"
+        "                    last_recurrent_state,\n"
+        "                )\n"
+    )
+    text = text.replace(write_anchor, write_inject, 1)
+
+    GDN_LINEAR_PATH.write_text(text)
+    return True
+
